        "autoprefixer": "^10.4.20",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-svelte": "^2.46.1",
        "prettier": "^3.3.3",
        "prettier-plugin-svelte": "^3.3.3",
        "sass": "^1.80.0",
        "svelte": "^5.33.0",
        "svelte-check": "^4.1.0",
        "tslib": "^2.7.0",
        "@types/node": "^20.0.0",
        "typescript": "^5.5.0",
        "vite": "^5.4.0"
